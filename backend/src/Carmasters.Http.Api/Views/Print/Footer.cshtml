@using Carmasters.Core.Application.Configuration
@using Carmasters.Core.Application.Model
@using Carmasters.Core.Domain
@using Carmasters.Http.Api
@model PricingPrintModel
@{
    var requisitesOptions = (RequisitesOptions)Model.RequisitesOptions;

    // Only what the garage actually filled in: an empty field would print as a stray separator.
    var contact = new[] { requisitesOptions.Name, requisitesOptions.Address,
                          string.IsNullOrWhiteSpace(requisitesOptions.Phone) ? null : "Tél. " + requisitesOptions.Phone,
                          requisitesOptions.Email }
        .Where(x => !string.IsNullOrWhiteSpace(x));

    var identifiers = new[] {
            string.IsNullOrWhiteSpace(requisitesOptions.RegNr) ? null : "Identifiant entreprise : " + requisitesOptions.RegNr,
            string.IsNullOrWhiteSpace(requisitesOptions.KMKR) ? null : "ICE / Identifiant fiscal : " + requisitesOptions.KMKR,
            requisitesOptions.BankAccount }
        .Where(x => !string.IsNullOrWhiteSpace(x));
}

<div style="width: 210mm; font-size: 9px; color: #6b716a;">
    <div style="margin: 0 1cm; border-top: 1px solid #c9cec7; padding-top: 2mm;">
        <div>@string.Join(" · ", contact)</div>
        <div>@string.Join(" · ", identifiers)</div>
        <div style="text-align: right; font-size: 8px;">
            <span class="pageNumber"></span> / <span class="totalPages"></span>
        </div>
    </div>
</div>
