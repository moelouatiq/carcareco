@using Carmasters.Core.Application.Configuration
@using Carmasters.Core.Application.Model
@using Carmasters.Core.Application.Printing
@using Carmasters.Core.Domain
@using Carmasters.Http.Api
@model PricingPrintModel
@{
    var pricing = (Pricing)Model.Pricing;
    var requisitesOptions = (RequisitesOptions)Model.RequisitesOptions;
    var pricingOptions = (PricingOptions)Model.PricingOptions;
    var invoice = pricing as Carmasters.Core.Domain.Invoice;
    var isInvoice = invoice != null;
    var hasDiscounts = pricing.Lines.Any(x => x.Discount != 0);

    // The VAT rate is the garage's own tax situation, not a property of the document. At zero
    // there is nothing to break the total into, and a "TVA 0,00 MAD" line would state a rate the
    // garage does not charge; what it does say instead is configured in Mentions légales.
    var vatRate = pricingOptions.Invoice?.VatRate ?? 0;
    var showVatBreakdown = isInvoice && vatRate > 0;

    // The number is padded for the page only: the domain keeps the int it sequenced, and the
    // file name keeps its own convention.
    var documentTitle = isInvoice
        ? "Facture n° " + PricingDisplay.InvoiceNumber(invoice.Number)
        : pricing.GetDisplayName();

    // The domain stores these already labelled, as "Véhicule : Renault Express", so the page
    // prints them as they are. A line that is only its label is dropped.
    var vehicleLines = new[] { pricing.VehicleLine1, pricing.VehicleLine2, pricing.VehicleLine3, pricing.VehicleLine4 }
        .Where(PricingDisplay.Says)
        .ToList();
}

<header class="doc-head">
    <div class="doc-head-party">
        <p class="doc-issuer">@requisitesOptions.Name</p>
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Address))
        {
            <p class="doc-line">@requisitesOptions.Address</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Phone))
        {
            <p class="doc-line">Téléphone : @requisitesOptions.Phone</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Email))
        {
            <p class="doc-line">@requisitesOptions.Email</p>
        }
    </div>
    <div class="doc-head-document">
        <p class="doc-title">@documentTitle</p>
        <p class="doc-line">Date : @PricingDisplay.LongDate(pricing.IssuedOn)</p>
        @{
            await Html.RenderPartialAsync("Print/LeftTop." + pricing.GetType().Name, (object)Model);
        }
    </div>
</header>

<section class="doc-parties">
    <div class="doc-party">
        <p class="doc-label">Client</p>
        <p class="doc-strong">@pricing.PartyName</p>
        @if (!string.IsNullOrWhiteSpace(pricing.PartyCode))
        {
            @* Named neutrally: the garage may have entered an ICE, an RC or another identifier,
               and the document must not assert which. *@
            <p class="doc-line">Identifiant client : @pricing.PartyCode</p>
        }
        @if (!string.IsNullOrWhiteSpace(pricing.PartyAddress))
        {
            <p class="doc-line">@pricing.PartyAddress</p>
        }
    </div>
    @if (vehicleLines.Count > 0)
    {
        <div class="doc-party">
            <p class="doc-label">Véhicule</p>
            @foreach (var line in vehicleLines)
            {
                @* The heading above already says Véhicule; the stored line must not say it again. *@
                <p class="doc-line">@PricingDisplay.WithoutHeadingLabel(line, "Véhicule")</p>
            }
        </div>
    }
</section>

<table class="doc-table">
    <thead>
        <tr>
            <th class="col-text">Désignation</th>
            <th class="col-num">Quantité</th>
            <th class="col-num">Unité</th>
            <th class="col-num">Prix unitaire</th>
            @if (hasDiscounts)
            {
                <th class="col-num">Remise %</th>
            }
            <th class="col-num col-last">Montant</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in pricing.Lines)
        {
            <tr>
                <td class="col-text">@item.Description</td>
                <td class="col-num">@PricingDisplay.Number(item.Quantity)</td>
                <td class="col-num">@item.Unit</td>
                <td class="col-num">@PricingDisplay.Amount(item.UnitPrice)</td>
                @if (hasDiscounts)
                {
                    <td class="col-num">@((item.Discount != null && item.Discount != 0) ? PricingDisplay.Number(item.Discount) + " %" : string.Empty)</td>
                }
                <td class="col-num col-last">@PricingDisplay.Amount(item.Total)</td>
            </tr>
        }
    </tbody>
</table>

<section class="doc-totals">
    <table class="doc-total-table">
        @if (showVatBreakdown)
        {
            <tr>
                <td class="doc-total-label">Total HT</td>
                <td class="doc-total-value">@PricingDisplay.Money(pricing.GetTotal(false))</td>
            </tr>
            <tr>
                <td class="doc-total-label">TVA (@vatRate %)</td>
                <td class="doc-total-value">@PricingDisplay.Money(pricing.GetTotal(true) - pricing.GetTotal(false))</td>
            </tr>
        }
        <tr class="doc-total-net">
            <td class="doc-total-label">Net à payer</td>
            <td class="doc-total-value">@PricingDisplay.Money(pricing.GetTotal(true))</td>
        </tr>
    </table>
</section>

<section class="doc-notes">
    <div>
        @{
            await Html.RenderPartialAsync("Print/LeftBottom." + pricing.GetType().Name, pricing);
        }
        @{
            await Html.RenderPartialAsync("Print/RightBottom." + pricing.GetType().Name, pricingOptions);
        }
    </div>
    @if (isInvoice && pricingOptions.Invoice?.SignatureLine == true)
    {
        <div class="doc-signature">
            <p class="doc-label">Signature</p>
            <div class="doc-signature-space"></div>
        </div>
    }
</section>

<footer class="doc-foot">
    <div>
        <span>@requisitesOptions.Name</span>
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Address))
        {
            <span> · @requisitesOptions.Address</span>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Phone))
        {
            <span> · Tél. @requisitesOptions.Phone</span>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Email))
        {
            <span> · @requisitesOptions.Email</span>
        }
    </div>
    <div>
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.RegNr))
        {
            <span>Identifiant entreprise : @requisitesOptions.RegNr</span>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.KMKR))
        {
            <span>@(string.IsNullOrWhiteSpace(requisitesOptions.RegNr) ? "" : " · ")ICE / Identifiant fiscal : @requisitesOptions.KMKR</span>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.BankAccount))
        {
            <span> · @requisitesOptions.BankAccount</span>
        }
    </div>
</footer>
