backend/src/Carmasters.Http.Api/dist/
backend/src/DbUp/dist/
/.env
/local-credentials.txt
.data-protection-keys/

# --- Local secrets and credentials -------------------------------------------
# Belt and braces: the per-project ignores below already cover the files the
# setup-secrets scripts write, but these patterns stop a stray copy, a sed
# backup or a new environment file from ever being staged by accident.
.env
.env.*
!.env.example

secrets.json
# Covers per-environment variants such as appsettings.Secrets.supabase-staging.json.
# The tracked *.example files end in .example, so they are not matched.
appsettings.Secrets*.json
local-credentials.txt

*.bak
*.key
*.pem
*.pfx
*.p12

# The Vercel image needs Supabase's root CA in its build context: verify-full validates the server
# against a root the public trust store does not carry. That one public certificate is versioned by
# name. Everything else in the directory stays ignored, so a key dropped there cannot be committed
# by accident, and the *.key/*.pem/*.pfx/*.p12 rules above still apply everywhere.
backend/certs/*
!backend/certs/prod-ca-2021.crt
