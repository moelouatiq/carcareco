# Docker Compose database settings. Run scripts/setup-secrets.ps1 on Windows
# or scripts/setup-secrets.sh on Linux instead of using these placeholders.
POSTGRES_USER=[random-db-user]
POSTGRES_PASSWORD=[random-db-password]
POSTGRES_DB=carcare
WEB_PORT=3000

# One-time local bootstrap account created by DbUp.
CARCARE_ADMIN_USERNAME=[random-admin-user]
CARCARE_ADMIN_PASSWORD=[random-admin-password]
CARCARE_ADMIN_EMAIL=admin@example.invalid
