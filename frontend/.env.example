# must equal ConsumerSecret in appsettings.Secrets.json
SERVER_SECRET=[your-server-secret]

# used for your own session‑cookie encryption
SESSION_SECRET=[random-32-byte-base64]

# Where the Next.js server reaches the backend. The browser never sees this value and never
# calls the backend itself: it talks to Next.js, which proxies to API_URL server side. On
# Vercel this variable is injected by the service binding and must not be set by hand.
API_URL=http://api:15567

# Optional: match your server timeouts
NEXT_PUBLIC_SESSION_TIMEOUT=1500
NEXT_PUBLIC_SESSION_DIALOG_TIMEOUT=120
